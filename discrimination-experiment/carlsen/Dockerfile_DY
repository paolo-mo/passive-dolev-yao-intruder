FROM eclipse-temurin:21-jdk-noble

# Set the AnBx Compiler version
ENV ANBX_VERSION=2026.09

# Set Ant version 
ENV ANT_VERSION=1.10.18

# Install required networking software
RUN apt-get update && apt-get install -y --no-install-recommends iptables tcpdump iputils-ping net-tools iproute2 nano && apt-get clean && rm -rf /var/lib/apt/lists/*

# Download and install Ant, using the existing JDK
RUN set -eux; FILE="apache-ant-${ANT_VERSION}-bin.tar.gz"; URL_PRIMARY="https://dlcdn.apache.org/ant/binaries/${FILE}"; URL_FALLBACK="https://archive.apache.org/dist/ant/binaries/${FILE}"; if ! curl -fsSL "$URL_PRIMARY" -o /tmp/ant.tar.gz; then echo "Primary CDN failed, using archive.apache.org"; curl -fsSL "$URL_FALLBACK" -o /tmp/ant.tar.gz; fi; tar -xzf /tmp/ant.tar.gz -C /opt; ln -s "/opt/apache-ant-${ANT_VERSION}" /opt/ant; ln -s /opt/ant/bin/ant /usr/local/bin/ant; rm /tmp/ant.tar.gz

# Set ANT_HOME environment variable
ENV ANT_HOME=/opt/ant

# set JAVA_OPTS
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

# set BouncyCastleProvider
RUN	echo 'security.provider.13=org.bouncycastle.jce.provider.BouncyCastleProvider' >> $JAVA_HOME/conf/security/java.security && echo 'security.provider.14=org.bouncycastle.pqc.jcajce.provider.BouncyCastlePQCProvider' >> $JAVA_HOME/conf/security/java.security
